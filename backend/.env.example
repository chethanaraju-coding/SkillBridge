# ================================================================
# SkillBridge Environment Configuration
# Copy this file to '.env' and fill in your local credentials.
# NEVER commit the actual '.env' file to source control.
# ================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key

# MySQL Database Configuration
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillbridge

# JWT Authentication Secret
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
